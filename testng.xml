<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Salesforce Login Test Suite" parallel="false">
    <listeners>
        <listener class-name="com.salesforce.utils.TestListener"/>
    </listeners>
    <test name="Valid Login Tests">
        <classes>
            <class name="com.salesforce.tests.ValidLoginTest"/>
        </classes>
    </test>
    <test name="Invalid Login Tests">
        <classes>
            <class name="com.salesforce.tests.InvalidLoginTest"/>
        </classes>
    </test>
</suite>
